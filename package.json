{
  "name": "jrichforms-xr-poc",
  "version": "0.1.0",
  "private": true,
  "description": "JRichForms XR monorepo — WebAR gallery + shared experience package",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jrichforms/web",
    "build": "npm run build -w @jrichforms/web",
    "start": "npm run start -w @jrichforms/web",
    "lint": "npm run lint -w @jrichforms/web",
    "postinstall": "node scripts/copy-xr-assets.mjs && node scripts/sync-content.mjs",
    "copy-xr": "node scripts/copy-xr-assets.mjs",
    "make-target": "node scripts/make-test-target.mjs",
    "sync-content": "node scripts/sync-content.mjs",
    "convert-meshy": "node scripts/convert-meshy-obj.mjs",
    "prepare-lenses": "node scripts/prepare-lenses-publish.mjs",
    "convert-usdz": "node scripts/convert-usdz.mjs",
    "publish-lenses": "node scripts/publish-lenses.mjs",
    "check-assets": "node scripts/check-assets.mjs"
  },
  "devDependencies": {
    "@8thwall/image-target-cli": "^1.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5"
  }
}
